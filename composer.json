{
    "name": "novay/bunny-secrets",
    "description": "A Laravel filesystem driver and helper facade for Bunny.net Storage with optional Borneo Secrets Manager API key resolution.",
    "keywords": [
        "bunny",
        "bunnycdn",
        "bunny-net",
        "cdn",
        "filesystem",
        "flysystem",
        "laravel",
        "secrets",
        "borneo-secrets-manager"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/novay/bunny-secrets",
    "authors": [
        {
            "name": "Novianto Rahmadi",
            "email": "novay@btekno.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "league/flysystem": "^3.0",
        "platformcommunity/flysystem-bunnycdn": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Novay\\BunnySecret\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Novay\\BunnySecret\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Novay\\BunnySecret\\BunnySecretServiceProvider"
            ],
            "aliases": {
                "BunnySecret": "Novay\\BunnySecret\\BunnySecret"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}